# ---------------------------------------------------------------------------
# Server environment — EXAMPLE ONLY. Copy to `.env` and fill in real values.
# NEVER commit real secrets here; `.env` is gitignored, this file is not.
# ---------------------------------------------------------------------------

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Gmail SMTP creds for email+password auth codes (verification + reset).
# GMAIL_APP_PASSWORD is a Google "app password", NOT the account password.
# If either is unset, codes are console.log'd in dev instead of emailed.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public URL of the frontend (CORS + OAuth/redirect building)
CLIENT_URL=http://localhost:5173

# Public URL of THIS SERVER — the API origin, NOT the frontend. Every URL a
# customer pastes into an external system is built from it: lead-source ingest
# URLs (Facebook / Zapier / website forms), inbound webhook URLs, email
# unsubscribe links, and the mailbox OAuth redirect URI.
# MUST be set on every deployed environment. When the frontend and API are on
# different hosts (e.g. client on Vercel, server on Render) this is the SERVER
# host: https://your-api.onrender.com — not the vercel.app domain.
# Unset in a deploy, the server falls back to the origin the request arrived on,
# which works but is not authoritative; OAuth/unsubscribe links need the real
# value. Locally it can stay blank (localhost:PORT is assumed).
WEBHOOK_PUBLIC_BASE_URL=

# Cloudinary (file uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Google OAuth — from Google Cloud Console → Credentials
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leadloop?appName=Cluster1

NODE_ENV=development
PORT=5000

# Auth
JWT_EXPIRES_IN=7d
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# --- Stripe billing (optional) ---------------------------------------------
# Leave blank to run without billing: the app boots fine and the Billing page
# reports "not connected" instead of offering checkout.
# Secret key from the Stripe dashboard (sk_live_… / sk_test_…)
STRIPE_SECRET_KEY=
# Signing secret for the /api/billing/webhook endpoint (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (price_…) — one per plan tier. A tier with no price id
# is shown as "Contact us" rather than a checkout that would fail.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BROKERAGE=
# Free-trial length in days on a workspace's first subscription (default 14)
STRIPE_TRIAL_DAYS=14
# Display-only monthly amounts shown on the pricing cards (per agent)
PRICE_AMOUNT_SOLO=29
PRICE_AMOUNT_TEAM=59
PRICE_AMOUNT_BROKERAGE=99
# Plan enforcement. Must be exactly "on" to BLOCK premium endpoints for
# workspaces without an entitled plan. Anything else (default) = enforcement
# off: entitlements are resolved and logged but nothing is blocked. Turn this
# on only after real Stripe plans exist AND existing workspaces are migrated.
BILLING_ENFORCEMENT=off

# --- Web Push (optional) -----------------------------------------------------
# Lead alerts on an agent's phone. Generate ONE pair, once:
#   npx web-push generate-vapid-keys
# Leave blank to run without push — the app works fine, the toggle just reports
# "not set up" instead of subscribing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto: that push services can reach you at
VAPID_SUBJECT=mailto:support@leadloop.app

# --- Ads & tracking: one-click connections (optional) -------------------------
# Each platform is independent. Leave its vars blank and the Ads & tracking hub
# shows it as "Coming soon on this server" — nothing else breaks. Tokens are
# stored AES-encrypted with EMAIL_TOKEN_ENCRYPTION_KEY, which must be set for
# ANY of these to be offered.
#
# Register these OAuth redirect URIs in each developer console
# (WEBHOOK_PUBLIC_BASE_URL is the API origin):
#   ${WEBHOOK_PUBLIC_BASE_URL}/api/ad-connect/callback/meta
#   ${WEBHOOK_PUBLIC_BASE_URL}/api/ad-connect/callback/google
#   ${WEBHOOK_PUBLIC_BASE_URL}/api/ad-connect/callback/tiktok
# After sign-in the browser returns to ${CLIENT_URL}/settings?tab=ads&connect=<platform>
# (or &connect_error=cancelled|expired|not_allowed|failed|not_configured).

# Meta (Facebook / Instagram) — developers.facebook.com → your app.
# Webhooks: subscribe the "Page" object, field "leadgen", callback
#   ${WEBHOOK_PUBLIC_BASE_URL}/api/ad-connect/webhooks/meta
# with META_WEBHOOK_VERIFY_TOKEN as the verify token. META_APP_SECRET also
# verifies every webhook's X-Hub-Signature-256.
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration id. When set, the
# consent dialog uses it (config_id) instead of the classic scope list.
META_LOGIN_CONFIG_ID=
# Any long random string; paste the same value into the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version (default v24.0)
META_API_VERSION=

# Google Ads — developer token from the Ads API Center (manager account), and an
# OAuth "Web application" client from Google Cloud Console with the Google Ads
# API (and Tag Manager API, for one-click GTM install) enabled.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# Legacy agency mode (manual settings — every client linked under your MCC).
# GOOGLE_ADS_OAUTH_CLIENT_ID/SECRET fall back to these when unset.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Google Ads API version (default v21)
GOOGLE_ADS_API_VERSION=

# TikTok for Business — business-api.tiktok.com → My apps. Instant Form leads
# are delivered to ${WEBHOOK_PUBLIC_BASE_URL}/api/ad-connect/webhooks/tiktok
# (LeadLoop registers it per advertiser with a per-workspace secret).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Marketing API version (default v1.3)
TIKTOK_API_VERSION=

# Token encryption (shared with mailbox / SMS / WhatsApp tokens) — 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_TOKEN_ENCRYPTION_KEY=
