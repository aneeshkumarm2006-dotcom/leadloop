# ---------------------------------------------------------------------------
# Server environment — EXAMPLE ONLY. Copy to `.env` and fill in real values.
# NEVER commit real secrets here; `.env` is gitignored, this file is not.
# ---------------------------------------------------------------------------

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Gmail SMTP creds for email+password auth codes (verification + reset).
# GMAIL_APP_PASSWORD is a Google "app password", NOT the account password.
# If either is unset, codes are console.log'd in dev instead of emailed.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public URL of the frontend (CORS + OAuth/redirect building)
CLIENT_URL=http://localhost:5173

# Cloudinary (file uploads)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Google OAuth — from Google Cloud Console → Credentials
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/leadloop?appName=Cluster1

NODE_ENV=development
PORT=5000

# Auth
JWT_EXPIRES_IN=7d
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# --- Stripe billing (optional) ---------------------------------------------
# Leave blank to run without billing: the app boots fine and the Billing page
# reports "not connected" instead of offering checkout.
# Secret key from the Stripe dashboard (sk_live_… / sk_test_…)
STRIPE_SECRET_KEY=
# Signing secret for the /api/billing/webhook endpoint (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs (price_…) — one per plan tier. A tier with no price id
# is shown as "Contact us" rather than a checkout that would fail.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BROKERAGE=
# Free-trial length in days on a workspace's first subscription (default 14)
STRIPE_TRIAL_DAYS=14
# Display-only monthly amounts shown on the pricing cards (per agent)
PRICE_AMOUNT_SOLO=29
PRICE_AMOUNT_TEAM=59
PRICE_AMOUNT_BROKERAGE=99
